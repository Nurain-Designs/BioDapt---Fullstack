{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "backend": "npm --prefix backend run dev",
    "dev:full": "concurrently \"npm run dev\" \"npm run backend\"",
    "build:pages": "VITE_DEMO_MODE=true vite build && node scripts/demo-notice.mjs \"Recommendations come from a built-in rule-based advisor, not a live AI model.\""
  },
  "dependencies": {
    "clsx": "2.1.1",
    "framer-motion": "^12.40.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
